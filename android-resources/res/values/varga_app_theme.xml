<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema applicativo senza Toolbar/ActionBar o titolo nativo. -->
    <style name="VargaAppTheme" parent="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="VargaAppTheme.Launch" parent="AppTheme.NoActionBarLaunch">
        <item name="postSplashScreenTheme">@style/VargaAppTheme</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
