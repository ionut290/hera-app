}
function manualPlantKeys() {
 return ['distretto','idSap','denominazione','comune','indirizzo','voceRiferimento','codicePrezzo','sfalci','areaMq','frequenzaAnnua','tipologiaIntervento','lavorazioniRichieste','gpsY','gpsX','numeroProgressivo','sortOrder','hasOrdinario','hasStraordinario','tipoManutenzione','done','doneAt','doneBy','createdAt'];
