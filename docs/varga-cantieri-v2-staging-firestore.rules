rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
 function eligible() {
 return request.auth != null && request.auth.token.get('email_verified', false) == true && request.auth.token.get('apple_review', false) == false;
 }
 function planWritable(tenantId) {
  let t = get(/databases/$(database)/documents/tenants/$(tenantId)).data;
  return !('plan' in t) || (t.plan == 'full' && (!('billing' in t) ||
    (t.billing.periodStart is timestamp && t.billing.periods is int
     && t.billing.periods>0 && t.billing.periods<=120
     && request.time < t.billing.periodStart + duration.value(t.billing.periods*30,'d')))) ||
    (t.plan == 'trial' && t.trialStartedAt is timestamp
     && t.trialDays == 30 && request.time < t.trialStartedAt + duration.value(30,'d'));
 }
 function activeMember(tenantId) {
 return eligible() && get(/databases/$(database)/documents/tenants/$(tenantId)).data.status == 'active' && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.status == 'active';
 }
 function companyAdmin(tenantId) {
 return eligible()
  && get(/databases/$(database)/documents/tenants/$(tenantId)).data.demo == true
  && get(/databases/$(database)/documents/tenants/$(tenantId)).data.status == 'active'
  && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role == 'admin'
  && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.status == 'active';
 }
 match /tenantJoinCodes/{code} {
  allow get: if eligible();
  allow create: if eligible()
    && getAfter(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.ownerUid == request.auth.uid
    && request.resource.data.status == 'active'
    && request.resource.data.createdBy == request.auth.uid;
 }
 // Emulator-only Super Admin management. Claims are issued server-side.
// No operational access bypass, no user creation/deletion, no reassignment of identities.
function verifiedSuperAdmin() {
 return eligible() && request.auth.token.get('superAdmin',false)==true;
}
function validTenantStatus(d) {
 return d.status in ['active','suspended'] && d.name is string && d.name.size()>=2 && d.name.size()<=120;
}
function demoTenant(tid) {
 return exists(/databases/$(database)/documents/tenants/$(tid))
 && get(/databases/$(database)/documents/tenants/$(tid)).data.demo==true;
}
function paidRoleTransition(uid,tid) {
 let t=get(/databases/$(database)/documents/tenants/$(tid)).data;
 let next=getAfter(/databases/$(database)/documents/tenants/$(tid)).data;
 let m=get(/databases/$(database)/documents/tenants/$(tid)/members/$(uid)).data;
 let n=getAfter(/databases/$(database)/documents/tenants/$(tid)/members/$(uid)).data;
 return t.plan=='full' && 'billing' in t && planWritable(tid)
  && uid!=t.ownerUid && uid!=request.auth.uid && t.status=='active'
  && m.status=='active' && n.status=='active' && m.demo==true && n.demo==true
  && m.role in ['admin','employee'] && n.role in ['admin','employee'] && m.role!=n.role
  && n.diff(m).affectedKeys().hasOnly(['role'])
  && next.lastRoleUid==uid
  && next.usage.diff(t.usage).affectedKeys().hasOnly(['admin','operatori'])
  && next.usage.admin==t.usage.admin+(n.role=='admin'?1:-1)
  && next.usage.operatori==t.usage.operatori+(n.role=='employee'?1:-1)
  && next.usage.admin>=1 && next.usage.admin<=t.limits.admin
  && next.usage.operatori>=0 && next.usage.operatori<=t.limits.operatori
  && get(/databases/$(database)/documents/users/$(uid)/memberships/$(tid)).data.role==m.role
  && getAfter(/databases/$(database)/documents/users/$(uid)/memberships/$(tid)).data.role==n.role
  && getAfter(/databases/$(database)/documents/users/$(uid)/memberships/$(tid)).data.status=='active';
}
function validMemberChange(uid,tid) {
 return verifiedSuperAdmin() && request.auth.uid!=uid && demoTenant(tid)
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status'])
 && (!(get(/databases/$(database)/documents/tenants/$(tid)).data.get('plan','') in ['trial','full']) || request.resource.data.role==resource.data.role || paidRoleTransition(uid,tid))
 && request.resource.data.role in ['admin','supervisor','employee']
 && request.resource.data.status in ['active','suspended'];
}
function sameMembership(a,b) {
 return a.role==b.role && a.status==b.status;
}
function planLimit(l,u,k,max) {
 return l[k] is int && l[k]>=u[k] && l[k]>=0 && l[k]<=max;
}
function validFullPlan() {
 let d=request.resource.data; let l=d.limits; let u=resource.data.usage;
 return resource.data.get('plan','')=='full' && !('billing' in resource.data)
  && d.plan=='full' && d.trial==false
  && d.diff(resource.data).affectedKeys().hasOnly(['plan','trial','limits','planUpdatedAt','planUpdatedBy','upgradeRequested'])
  && l.keys().hasAll(['commesse','impianti','admin','operatori','mezzi','squadre','storageBytes','personale'])
  && l.keys().hasOnly(['commesse','impianti','admin','operatori','mezzi','squadre','storageBytes','personale'])
  && l.admin==1 && u.admin==1
  && planLimit(l,u,'commesse',100000) && l.commesse>=1
  && planLimit(l,u,'impianti',1000000) && l.impianti>=1
  && planLimit(l,u,'operatori',10000) && planLimit(l,u,'mezzi',10000)
  && planLimit(l,u,'squadre',10000) && planLimit(l,u,'personale',10000)
  && planLimit(l,u,'storageBytes',1000000000000)
  && d.planUpdatedAt==request.time && d.planUpdatedBy==request.auth.uid && d.upgradeRequested==false;
}
// Fixed commercial catalog: independent of the client.
function commercialLimits(tier) {
 return tier=='starter' ? {'commesse':10,'impianti':300,'admin':1,'operatori':15,'personale':15,'mezzi':15,'squadre':5,'storageBytes':1000000000} :
 tier=='professional' ? {'commesse':50,'impianti':2000,'admin':3,'operatori':50,'personale':50,'mezzi':50,'squadre':20,'storageBytes':5000000000} :
 {'commesse':200,'impianti':10000,'admin':10,'operatori':200,'personale':200,'mezzi':200,'squadre':100,'storageBytes':20000000000};
}
function commercialPrice(tier) { return tier=='starter'?1990:tier=='professional'?3990:7990; }
function commercialTier(tier) { return tier in ['starter','professional','business']; }
function withinCommercialUsage(l,u) {
 return l.admin>=u.admin && l.commesse>=u.commesse && l.impianti>=u.impianti
  && l.operatori>=u.operatori && l.personale>=u.personale && l.mezzi>=u.mezzi
  && l.squadre>=u.squadre && l.storageBytes>=u.storageBytes;
}
function oldPeriodActive(t) {
 return 'billing' in t && t.billing.periodStart is timestamp && t.billing.periods is int
  && request.time < t.billing.periodStart+duration.value(t.billing.periods*30,'d');
}
function validBillingPeriod(b,t) {
 return oldPeriodActive(t) ?
  (b.tier==t.billing.tier && b.periodStart==t.billing.periodStart && b.periods==t.billing.periods+1) :
  (b.periodStart==request.time && b.periods==1);
}
function validCommercialActivation(tid) {
 let d=request.resource.data; let b=d.billing; let t=resource.data;
 return !('stripeTestSubscriptionId' in t) && !('stripeSandboxCheckoutId' in t) && t.get('plan','') in ['trial','full'] && d.plan=='full' && d.trial==false
  && d.diff(t).affectedKeys().hasOnly(['plan','trial','limits','billing','planUpdatedAt','planUpdatedBy','upgradeRequested','requestedTier'])
  && b.keys().hasOnly(['tier','amountCents','currency','periodStart','periods','reference','recordedAt','recordedBy','source'])
  && commercialTier(b.tier) && b.amountCents==commercialPrice(b.tier) && b.currency=='EUR'
   && b.source=='manual-confirmation' && b.reference is string && b.reference.matches('^[A-Za-z0-9_-]{6,80}
 // Bootstrap metadata only; never grant access to operational documents here.
 match /users/{uid}/memberships/{tenantId} {
  allow get,list: if eligible() && request.auth.uid==uid;
  allow create: if eligible()
    && request.auth.uid == uid
    && !exists(/databases/$(database)/documents/tenants/$(tenantId))
    && getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid
    && request.resource.data.tenantId == tenantId
    && request.resource.data.role == 'admin'
    && request.resource.data.status == 'active'
    && request.resource.data.demo == true;
  allow create: if companyAdmin(tenantId)
    && get(/databases/$(database)/documents/tenants/$(tenantId)/joinRequests/$(uid)).data.status == 'pending'
    && getAfter(/databases/$(database)/documents/tenants/$(tenantId)/joinRequests/$(uid)).data.status == 'accepted'
    && getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data.lastOperatorUid == uid
    && getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data.usage.operatori == get(/databases/$(database)/documents/tenants/$(tenantId)).data.usage.operatori + 1
    && getAfter(/databases/$(database)/documents/tenants/$(tenantId)/members/$(uid)).data.role == 'employee'
    && getAfter(/databases/$(database)/documents/tenants/$(tenantId)/members/$(uid)).data.status == 'active'
    && request.resource.data.tenantId == tenantId
    && request.resource.data.role == 'employee'
    && request.resource.data.status == 'active'
    && request.resource.data.demo == true;
 }
 match /tenants/{tenantId} {
  allow get: if canReadDemoCommesse();
  match /members/{uid} {
   allow get: if eligible() && request.auth.uid==uid && canReadDemoCommesse();
  }
 // Self-service trial onboarding and company-code membership requests.
// All bootstrap writes must be authenticated, verified and tenant-scoped.
function canCreateTrialTenant() {
 return eligible()
  && request.auth.uid == request.resource.data.ownerUid
  && request.resource.data.demo == true
  && request.resource.data.status == 'active'
  && request.resource.data.plan == 'trial'
  && request.resource.data.trial == true
  && request.resource.data.trialStartedAt == request.time
  && request.resource.data.trialDays == 30
  && request.resource.data.limits == {'commesse':5,'impianti':100,'admin':1,'operatori':11,'mezzi':11,'squadre':2,'storageBytes':100000000,'personale':11}
  && request.resource.data.usage == {'commesse':0,'impianti':0,'admin':1,'operatori':0,'mezzi':0,'squadre':0,'storageBytes':0,'personale':0}
  && request.resource.data.keys().hasOnly(['name','status','demo','ownerUid','joinCode','plan','trial','trialStartedAt','trialDays','limits','usage','originalCreateEnabled','originalManualEnabled','originalArchivesEnabled','commesseWriteEnabled','snowCreateEnabled','fattoMode','createdAt','createdBy'])
  && request.resource.data.name is string && request.resource.data.name.size()>=2 && request.resource.data.name.size()<=120
  && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid
  && request.resource.data.joinCode.matches('VC-[A-Z0-9]{8}')
  && getAfter(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role == 'admin'
  && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(tenantId)).data.role == 'admin';
}
allow create: if canCreateTrialTenant();
// Owner may request upgrade even after trial expiry. Cannot change plan or counters.
allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upgradeRequested','upgradeRequestedAt','requestedTier'])
 && companyAdmin(tenantId) && resource.data.plan in ['trial','full']
 && resource.data.ownerUid==request.auth.uid
 && !('stripeSandboxCheckoutId' in resource.data) && !('stripeTestSubscriptionId' in resource.data)
 && request.resource.data.requestedTier in ['starter','professional','business']
 && request.resource.data.upgradeRequested==true
 && request.resource.data.upgradeRequestedAt==request.time;
// Each acceptance must atomically consume exactly one slot and create both membership records.
// The request UID binds the counter increment to one pending request.
function validOperatorApproval(uid) {
 let before = get(/databases/$(database)/documents/tenants/$(tenantId)).data;
 let after = getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data;
 let req = get(/databases/$(database)/documents/tenants/$(tenantId)/joinRequests/$(uid)).data;
 let approved = getAfter(/databases/$(database)/documents/tenants/$(tenantId)/joinRequests/$(uid)).data;
 return companyAdmin(tenantId)
  && before.plan in ['trial','full']
  && planWritable(tenantId)
  && before.usage.operatori is int && before.usage.operatori >= 0
  && before.limits.operatori is int && before.usage.operatori < before.limits.operatori
  && after.usage.operatori == before.usage.operatori + 1
  && after.lastOperatorUid == uid
  && req.status == 'pending' && approved.status == 'accepted';
}
function validOperatorCounter() {
 let uid = request.resource.data.lastOperatorUid;
 return uid is string && uid.size()>0 && uid.size()<=128
  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usage','lastOperatorUid'])
  && request.resource.data.usage.diff(resource.data.usage).affectedKeys().hasOnly(['operatori'])
  && validOperatorApproval(uid)
  && !exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(uid))
  && !exists(/databases/$(database)/documents/users/$(uid)/memberships/$(tenantId))
  && getAfter(/databases/$(database)/documents/tenants/$(tenantId)/members/$(uid)).data.role == 'employee'
  && getAfter(/databases/$(database)/documents/users/$(uid)/memberships/$(tenantId)).data.role == 'employee';
}
allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usage','lastOperatorUid']) && validOperatorCounter();
match /members/{uid} {
 allow create: if eligible()
  && uid == request.auth.uid
  && !exists(/databases/$(database)/documents/tenants/$(tenantId))
  && getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid
  && request.resource.data.uid == request.auth.uid
  && request.resource.data.role == 'admin'
  && request.resource.data.status == 'active'
  && request.resource.data.demo == true;
 allow create: if validOperatorApproval(uid)
  && getAfter(/databases/$(database)/documents/users/$(uid)/memberships/$(tenantId)).data.role == 'employee'
  && getAfter(/databases/$(database)/documents/users/$(uid)/memberships/$(tenantId)).data.status == 'active'
  && request.resource.data.uid == uid
  && request.resource.data.role == 'employee'
  && request.resource.data.status == 'active'
  && request.resource.data.demo == true;
}
match /joinRequests/{uid} {
 allow create: if eligible()
  && uid == request.auth.uid
  && get(/databases/$(database)/documents/tenants/$(tenantId)).data.status == 'active'
  && planWritable(tenantId)
  && request.resource.data.uid == request.auth.uid
  && request.resource.data.status == 'pending'
  && request.resource.data.email == request.auth.token.email
  && request.resource.data.joinCode is string
  && request.resource.data.joinCode.matches('VC-[A-Z0-9]{8}')
  && get(/databases/$(database)/documents/tenantJoinCodes/$(request.resource.data.joinCode)).data.tenantId == tenantId
  && get(/databases/$(database)/documents/tenantJoinCodes/$(request.resource.data.joinCode)).data.status == 'active';
 allow get: if eligible() && (uid == request.auth.uid || companyAdmin(tenantId));
 allow list: if companyAdmin(tenantId);
 allow update: if companyAdmin(tenantId) && planWritable(tenantId)
  && resource.data.status == 'pending'
  && request.resource.data.uid == resource.data.uid
  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
  && (request.resource.data.status == 'rejected' || (request.resource.data.status == 'accepted' && validOperatorApproval(uid)))
  && request.resource.data.reviewedBy == request.auth.uid
  && request.resource.data.reviewedAt == request.time;
 allow delete: if false;
}

// Within tenant match. One new resource per atomic reservation; no client counter resets.
function managedPlan(t) { return t.get('plan','') in ['trial','full']; }
function quotaArchive(q) {
 return (q.kind=='commesse' && q.archive in ['commesse','neve_commesse','globalCommesse'])
  || (q.kind=='impianti' && q.archive in ['commesse','neve_commesse','globalCommesse'])
  || (q.kind=='mezzi' && q.archive in ['mezzi','neve_mezzi'])
  || (q.kind=='personale' && q.archive in ['personale','neve_personale']);
}
function quotaNewDocument(q) {
 return q.kind=='impianti'
  ? (!exists(/databases/$(database)/documents/tenants/$(tenantId)/$(q.archive)/$(q.parent)/impianti/$(q.id))
    && existsAfter(/databases/$(database)/documents/tenants/$(tenantId)/$(q.archive)/$(q.parent)/impianti/$(q.id)))
  : (!exists(/databases/$(database)/documents/tenants/$(tenantId)/$(q.archive)/$(q.id))
    && existsAfter(/databases/$(database)/documents/tenants/$(tenantId)/$(q.archive)/$(q.id)));
}
function quotaStep(before,after,q) {
 return before.usage[q.kind] is int && before.usage[q.kind]>=0
  && before.limits[q.kind] is int
  && before.usage[q.kind]<before.limits[q.kind]
  && after.usage[q.kind]==before.usage[q.kind]+1
  && after.lastQuotaWrite==q;
}
function validQuotaCounter() {
 let q=request.resource.data.lastQuotaWrite;
 return companyAdmin(tenantId) && planWritable(tenantId) && managedPlan(resource.data)
  && q is map && q.keys().hasAll(['kind','archive','id','parent']) && q.keys().hasOnly(['kind','archive','id','parent'])
  && q.id is string && q.id.size()>0 && q.parent is string
  && quotaArchive(q) && (q.kind=='impianti' ? q.parent.size()>0 : q.parent=='')
  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usage','lastQuotaWrite'])
  && request.resource.data.usage.diff(resource.data.usage).affectedKeys().hasOnly([q.kind])
  && quotaStep(resource.data,request.resource.data,q) && quotaNewDocument(q);
}
function quotaCreate(kind,archive,id,parent) {
 let before=get(/databases/$(database)/documents/tenants/$(tenantId)).data;
 let q={'kind':kind,'archive':archive,'id':id,'parent':parent};
 return planWritable(tenantId) && (!managedPlan(before) ||
  quotaStep(before,getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data,q));
}
allow update: if request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastQuotaWrite']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usage','lastQuotaWrite']) && validQuotaCounter();

// Candidate fragment ONLY. Not a deployable rules file.
// Insert inside match /tenants/{tenantId} of the tested staging rules,
// never into the inherited production rules.
// Requires existing eligible() and activeMember(tenantId) helpers.
match /{verdeCollection}/{documentId} {
  allow get, list: if verdeCollection in [
    'verdeLevatoRecords', 'verdeLevatoCommesse', 'verdeLevatoConfig'
  ]
  && activeMember(tenantId)
  && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role in ['admin', 'supervisor', 'employee']
  && get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(tenantId)).data.status == 'active'
  && get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(tenantId)).data.tenantId == tenantId
  && get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(tenantId)).data.role == get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role
  && get(/databases/$(database)/documents/tenants/$(tenantId)).data.demo == true;
  allow create, update, delete: if false;
}

// Emulator candidate only. Insert within /tenants/{tenantId}.
function canReadDemoCommesse() {
 return activeMember(tenantId)
 && get(/databases/$(database)/documents/tenants/$(tenantId)).data.demo == true
 && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role in ['admin','supervisor','employee']
 && get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(tenantId)).data.status == 'active'
 && get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(tenantId)).data.tenantId == tenantId
 && get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(tenantId)).data.role == get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role;
}
match /commesse/{commessaId} {
 allow get, list: if canReadDemoCommesse();
 allow create, update, delete: if false;
 match /impianti/{impiantoId} {
  allow get, list: if canReadDemoCommesse();
  allow create, update, delete: if false;
 }
}

// Generic company-owned commesse. Sfalcio COBO keeps its dedicated constrained rules.
function canManageCommesse() {
 return canReadDemoCommesse() && planWritable(tenantId)
 && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role == 'admin';
}
function canManagePrototypeCommesse() {
 return canManageCommesse() && get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('commesseWriteEnabled',false)==true;
}
function canManageCantieri() {
 return canManagePrototypeCommesse();
}
function commessaKeys() {
 return ['nome','codice','descrizione','cliente','committente','comune','indirizzo','attiva','tipo','createdAt','updatedAt','createdBy','updatedBy'];
}
function cantiereKeys() {
 return ['id','commessaId','nome','denominazione','comune','indirizzo','descrizione','coordinate','latitudine','longitudine','gpsX','gpsY','tipologia','note','stato','createdAt','updatedAt','createdBy','updatedBy'];
}
match /commesse/{commessaId} {
 allow create: if commessaId != 'sfalcio-cobo' && canManagePrototypeCommesse() && quotaCreate('commesse','commesse',commessaId,'')
 && request.resource.data.keys().hasOnly(commessaKeys())
 && request.resource.data.keys().hasAll(['nome','createdAt','createdBy'])
 && request.resource.data.nome is string && request.resource.data.nome.size()>0
 && request.resource.data.createdBy==request.auth.uid
 && request.resource.data.createdAt==request.time;
 allow update: if commessaId != 'sfalcio-cobo' && canManagePrototypeCommesse()
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(commessaKeys().toSet().difference(['createdAt','createdBy'].toSet()))
 && request.resource.data.createdBy==resource.data.createdBy
 && request.resource.data.createdAt==resource.data.createdAt
 && request.resource.data.updatedBy==request.auth.uid
 && request.resource.data.updatedAt==request.time;
 allow get,list: if canReadDemoCommesse();
 allow delete: if false;
 match /impianti/{impiantoId} {
  allow create: if commessaId != 'sfalcio-cobo' && quotaCreate('impianti','commesse',impiantoId,commessaId) && canManageCantieri()
  && request.resource.data.keys().hasOnly(cantiereKeys())
  && request.resource.data.keys().hasAll(['id','commessaId','createdAt','createdBy'])
  && request.resource.data.id==impiantoId
  && request.resource.data.commessaId==commessaId
  && request.resource.data.createdBy==request.auth.uid
  && request.resource.data.createdAt==request.time
  && exists(/databases/$(database)/documents/tenants/$(tenantId)/commesse/$(commessaId))
  && (!('stato' in request.resource.data) || request.resource.data.stato in ['da_fare','in_lavorazione']);
  allow update: if commessaId != 'sfalcio-cobo' && canManageCantieri()
  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(cantiereKeys().toSet().difference(['id','commessaId','createdAt','createdBy','stato'].toSet()))
  && request.resource.data.id==resource.data.id
  && request.resource.data.commessaId==resource.data.commessaId
  && request.resource.data.createdAt==resource.data.createdAt
  && request.resource.data.createdBy==resource.data.createdBy;
  allow get,list: if canReadDemoCommesse();
  allow delete: if false;
 }
}

// Emulator-only candidate: exact initial payloads from original app.js handlers.
// Do not deploy: no operational update, deletion or FATTO permission is granted here.
function originalCommessaCreate(archive) {
 let d=request.resource.data;
 return canManageCommesse()
 && get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('originalCreateEnabled',false)==true
 && d.keys().hasOnly(['nome','codice','excelModelVersion','priceListVersion','workItemsModelVersion','percentualeRibassoGenerale','excelModelActivatedAt','excelModelActivatedBy','nextImpiantoNumber','parentCommessaId','creatoDa','createdAt'])
 && d.keys().hasAll(['nome','codice','excelModelVersion','priceListVersion','workItemsModelVersion','percentualeRibassoGenerale','excelModelActivatedAt','excelModelActivatedBy','nextImpiantoNumber','parentCommessaId','creatoDa','createdAt'])
 && d.nome is string && d.nome.matches('.*[^\\s].*') && d.nome.size()<=200
 && d.codice is string && d.codice.size()<=200
 && d.excelModelVersion==2 && d.priceListVersion==2 && d.workItemsModelVersion==2
 && d.percentualeRibassoGenerale==0.01 && d.nextImpiantoNumber==1
