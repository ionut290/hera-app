 && d.distretto=='' && d.idSap=='' && d.voceRiferimento=='' && d.sfalci=='' && d.areaMq==null
 && d.frequenzaAnnua=='' && d.tipologiaIntervento=='' && d.lavorazioniRichieste==''
 && d.gpsY==null && d.gpsX==null && d.done==false && d.doneAt==null && d.doneBy==''
