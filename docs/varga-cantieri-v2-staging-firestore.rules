 && d.keys().hasAll(['denominazione','idSap','tipologiaImpianto','comune','indirizzo','gpsY','gpsX','codicePrezzo','area','dittaEsecutrice','note','stato','done','doneAt','doneBy','numeroProgressivo','commessaId','createdAt','updatedAt','updatedByUid','updatedByName'])
 && d.denominazione is string && d.denominazione.matches('.*[^\\s].*') && d.denominazione.size()<=250
 && d.idSap is string && d.idSap.size()<=200
 && d.tipologiaImpianto=='' && d.comune=='' && d.indirizzo=='' && d.gpsY==null && d.gpsX==null
 && d.codicePrezzo=='' && d.area=='' && d.dittaEsecutrice=='' && d.note==''
 && d.stato=='DA FARE' && d.done==false && d.doneAt==null && d.doneBy==''
