{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "README.md",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "docs/**",
      "scripts/**",
      "android/**",
      "ios/**",
      "netlify/**",
      "tests/**",
      "test/**",
      "coverage/**",
      "artifacts/**",
      "**/*.md",
      "**/*.cjs",
      "**/*.mjs",
      "**/*.sh",
      "**/*.py",
      "**/*.rb",
      "**/*.key",
      "**/*.pem",
      "**/*.p12",
      "**/*.p8",
      "**/*.mobileprovision",
      "**/*.keystore",
      "**/*.zip",
      "**/*.tar",
      "**/*.gz",
      "**/*.db",
      "**/*.sqlite",
      "**/*.sql",
      "**/*.csv",
      "**/*.xlsx",
      "**/*.xls",
      "**/*.pdf",
      "**/*.map",
      "package.json",
      "package-lock.json",
      "netlify.toml",
      "firestore.rules",
      "storage.rules",
      "firestore.indexes.json",
      "capacitor.config.*",
      "GoogleService-Info.plist",
      "google-services.json"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=300"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/fuel-stations-italy",
        "function": "getFuelStationsItaly"
      },
      {
        "source": "/pos",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  }
}
