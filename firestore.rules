rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authPresent() {
      return request.auth != null;
    }

    function signedIn() {
      return authPresent()
        && (isAdmin() || (request.auth.token.email_verified == true && !isBannedUser()));
    }

    function isBannedUser() {
      return authPresent()
        && exists(/databases/$(database)/documents/platformUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data.get("banned", false) == true;
    }

    function isAdmin() {
      return authPresent()
        && (
          request.auth.token.email in ["ionut29019@gmail.com", "Ionut29019@gmail.com"]
          || (
            exists(/databases/$(database)/documents/appConfig/adminUsers)
            && request.auth.token.email in get(/databases/$(database)/documents/appConfig/adminUsers).data.emails
          )
        );
    }

    function isSelf(userId) {
      return authPresent() && request.auth.uid == userId;
    }

    function canReadNotification() {
      return signedIn() && (isAdmin() || resource.data.scopeType == "GLOBALE" || request.auth.uid in resource.data.recipientUserIds);
    }

    function onlyPersonalNotificationStateChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy", "deletedBy", "updatedAt"])
        && request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.deletedBy.diff(resource.data.deletedBy).affectedKeys().hasOnly([request.auth.uid]);
    }

    match /notifications/{notificationId} {
      allow read: if canReadNotification();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (canReadNotification() && onlyPersonalNotificationStateChanged());
    }

    function createsNoInlinePosition() {
      return !("lastPosition" in request.resource.data);
    }

    function updatesNoInlinePosition() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastPosition"]);
    }

    function createsNoPermissionFields() {
      return !request.resource.data.keys().hasAny(["allowedImpiantoActions", "deniedImpiantoActions"]);
    }

    function updatesNoPermissionFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["allowedImpiantoActions", "deniedImpiantoActions"]);
    }

    function createsNoBanFields() {
      return !request.resource.data.keys().hasAny(["banned", "bannedReason", "bannedAt", "bannedBy"]);
    }

    function updatesNoBanFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["banned", "bannedReason", "bannedAt", "bannedBy"]);
    }

    match /commesse/{commessaId} {
      allow read: if signedIn();
      allow write: if signedIn();

      match /{document=**} {
        allow read, write: if signedIn();
      }
    }

    // Il report contiene dati storici degli operatori ed è solo amministrativo.
    match /inreteMigrationAudit/{migrationId} {
      allow read, write: if isAdmin();
    }

    match /squadre/{squadraId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /squadreCommesse/{squadraId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /squadreStorico/{squadraId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }


    match /neve_commesse/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /{document=**} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }


    match /neve_squadre/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }


    match /neve_squadre_storico/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /weatherAlerts/{alertId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /servizioNeveClienti/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /servizioNevePercorsi/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /servizioNeveMezzi/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /servizioNeveOperatori/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /servizioNeveSegnalazioni/{docId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /servizioNeveImpostazioni/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /worklimateRiskByImpianto/{riskId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /alertReadConfirmations/{confirmationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.utente == request.auth.uid);
      allow create: if signedIn() && request.resource.data.utente == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /programmazioni/{programmazioneId} {
      allow read: if isAdmin() || (
        signedIn()
        && (
          request.auth.token.email in resource.data.operatoriCoinvolti
          || request.auth.token.name in resource.data.operatoriCoinvolti
        )
      );
      allow create, update, delete: if isAdmin();
    }

    match /calendarEvents/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.title is string
        && request.resource.data.type in [
          "ferie",
          "permesso",
          "malattia",
          "intervento",
          "riunione",
          "formazione",
          "scadenza",
          "altro"
        ];
      allow update: if signedIn()
        && (isAdmin() || resource.data.createdByUid == request.auth.uid)
        && request.resource.data.createdByUid == resource.data.createdByUid;
      allow delete: if signedIn()
        && (isAdmin() || resource.data.createdByUid == request.auth.uid);
    }

    match /posDocuments/{docId} {
      allow read: if resource.data.active == true || signedIn();
      allow create, update, delete: if isAdmin();
    }

    function validOperatorPositionWrite(userId) {
      return signedIn()
        && isSelf(userId)
        && request.resource.data.userId == userId
        && request.resource.data.uid == userId
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.stato in ["online", "offline"]
        && request.resource.data.status in ["online", "offline"];
    }


    match /appConfig/driveAdminSecret {
      allow read, write: if isAdmin();
    }

    match /appConfig/driveBridge {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /appConfig/{configId} {
      allow read, write: if signedIn() && !(configId in ["driveAdminSecret", "driveBridge"]);
    }

    match /activityLogs/{logId} {
      allow read, update, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    match /operatorPositions/{userId} {
      allow read: if isAdmin();
      allow create, update: if validOperatorPositionWrite(userId);
      allow delete: if isAdmin();
    }

    match /platformUsers/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create: if isAdmin() || (isSelf(userId) && createsNoInlinePosition() && createsNoPermissionFields() && createsNoBanFields());
      allow update: if isAdmin() || (isSelf(userId) && !isBannedUser() && updatesNoInlinePosition() && updatesNoPermissionFields() && updatesNoBanFields());
      allow delete: if isAdmin();
    }

    match /chatMessages/{messageId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /safetyContacts/{contactId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{collection}/{docId} {
      allow read, write: if signedIn() && collection in [
        "appNotifications",
        "commessaResources",
        "globalCommesse",
        "gpsUpdateRequests",
        "hoursDeadlineAlerts",
        "items",
        "mezzi",
        "noteCommessa",
        "notificationEmailQueue",
        "oreApprovalRequests",
        "oreLocks",
        "oreReports",
        "neve_ore_richieste",
        "neve_ore",
        "personale",
        "privateDocuments",
        "sheetExportQueue",
        "userAlertAcknowledgements",
        "userAlerts",
        "utenti"
      ];

      match /{document=**} {
        allow read, write: if signedIn() && collection in [
          "globalCommesse",
          "privateDocuments"
        ];
      }
    }
  }
}
