rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /commesse/{commessaId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    match /squadre/{squadraId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /squadreCommesse/{squadraId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /squadreStorico/{squadraId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /posDocuments/{docId} {
      allow read: if resource.data.active == true || request.auth != null;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email in [
          "ionut29019@gmail.com"
        ];
    }

    match /{collection}/{docId} {
      allow read, write: if request.auth != null && collection in [
        "appConfig",
        "appNotifications",
        "chatMessages",
        "commessaResources",
        "globalCommesse",
        "gpsUpdateRequests",
        "hoursDeadlineAlerts",
        "items",
        "mezzi",
        "noteCommessa",
        "notificationEmailQueue",
        "oreApprovalRequests",
        "oreReports",
        "personale",
        "platformUsers",
        "privateDocuments",
        "sheetExportQueue",
        "squadreCommesse",
        "squadreStorico",
        "userAlertAcknowledgements",
        "userAlerts"
      ];

      match /{document=**} {
        allow read, write: if request.auth != null && collection in [
          "globalCommesse",
          "privateDocuments"
        ];
      }
    }
  }
}
