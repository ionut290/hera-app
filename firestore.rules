rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /commesse/{commessaId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    match /squadre/{squadraId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /squadreCommesse/{squadraId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /squadreStorico/{squadraId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
