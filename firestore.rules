rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authPresent() {
      return request.auth != null;
    }

    function signedIn() {
      return authPresent()
        && (isAdmin() || (request.auth.token.email_verified == true && !isBannedUser() && hasActiveAccount()));
    }

    // I profili storici senza stato restano autorizzati; ogni nuovo profilo nasce in_attesa.
    function hasActiveAccount() {
      return exists(/databases/$(database)/documents/platformUsers/$(request.auth.uid))
        && (
          !get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data.keys().hasAny(["statoAccount", "accountStatus"])
          || get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data.get("statoAccount", get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data.get("accountStatus", "")) == "attivo"
        );
    }

    function isBannedUser() {
      return authPresent()
        && exists(/databases/$(database)/documents/platformUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data.get("banned", false) == true;
    }

    function isAdmin() {
      return authPresent()
        && (
          request.auth.token.email in ["ionut29019@gmail.com", "Ionut29019@gmail.com"]
          || (
            exists(/databases/$(database)/documents/appConfig/adminUsers)
            && request.auth.token.email in get(/databases/$(database)/documents/appConfig/adminUsers).data.emails
          )
        );
    }

    function isSelf(userId) {
      return authPresent() && request.auth.uid == userId;
    }

    function canReadNotification() {
      return signedIn() && (isAdmin() || resource.data.scopeType == "GLOBALE" || request.auth.uid in resource.data.recipientUserIds);
    }

    function onlyPersonalNotificationStateChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy", "deletedBy", "updatedAt"])
        && request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.deletedBy.diff(resource.data.deletedBy).affectedKeys().hasOnly([request.auth.uid]);
    }

    match /notifications/{notificationId} {
      allow read: if canReadNotification();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (canReadNotification() && onlyPersonalNotificationStateChanged());
    }

    function createsNoInlinePosition() {
      return !("lastPosition" in request.resource.data);
    }

    function updatesNoInlinePosition() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastPosition"]);
    }

    function createsNoPermissionFields() {
      return !request.resource.data.keys().hasAny(["allowedImpiantoActions", "deniedImpiantoActions"]);
    }

    function updatesNoPermissionFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["allowedImpiantoActions", "deniedImpiantoActions"]);
    }

    function createsNoBanFields() {
      return !request.resource.data.keys().hasAny(["banned", "bannedReason", "bannedAt", "bannedBy"]);
    }

    function updatesNoBanFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["banned", "bannedReason", "bannedAt", "bannedBy"]);
    }

    function validPendingProfileCreate(userId) {
      return isSelf(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.statoAccount == "in_attesa"
        && request.resource.data.accountStatus == "in_attesa"
        && request.resource.data.role == "user"
        && request.resource.data.ruolo == "user"
        && request.resource.data.get("isAdmin", false) == false
        && request.resource.data.get("admin", false) == false;
    }

    function validSelfProfileUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "statoAccount", "accountStatus", "role", "ruolo", "isAdmin", "admin",
        "approvatoAt", "approvedAt", "approvatoDa", "approvedBy", "approvatoDaEmail",
        "rifiutatoAt", "rejectedAt", "rifiutatoDa", "rejectedBy", "motivoRifiuto"
      ]) || (
        resource.data.get("statoAccount", "") in ["in_attesa", "richiesta_inviata"]
        && request.resource.data.statoAccount == "richiesta_inviata"
        && request.resource.data.accountStatus == "richiesta_inviata"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "statoAccount", "accountStatus", "richiestaWhatsappAt", "whatsappRequestedAt",
          "ultimaRichiestaAt", "lastRequestAt", "numeroRichieste", "requestCount"
        ])
      );
    }

    match /commesse/{commessaId} {
      allow read: if signedIn();
      allow write: if signedIn();

      match /{document=**} {
        allow read, write: if signedIn();
      }
    }

    // Il report contiene dati storici degli operatori ed è solo amministrativo.
    match /inreteMigrationAudit/{migrationId} {
      allow read, write: if isAdmin();
    }

    match /squadre/{squadraId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /squadreCommesse/{squadraId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /squadreStorico/{squadraId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }


    match /neve_commesse/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /{document=**} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }


    match /neve_squadre/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }


    match /neve_squadre_storico/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /weatherAlerts/{alertId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /servizioNeveClienti/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /servizioNevePercorsi/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /servizioNeveMezzi/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /servizioNeveOperatori/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /servizioNeveSegnalazioni/{docId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /servizioNeveImpostazioni/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /worklimateRiskByImpianto/{riskId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /alertReadConfirmations/{confirmationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.utente == request.auth.uid);
      allow create: if signedIn() && request.resource.data.utente == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /programmazioni/{programmazioneId} {
      allow read: if isAdmin() || (
        signedIn()
        && (
          request.auth.token.email in resource.data.operatoriCoinvolti
          || request.auth.token.name in resource.data.operatoriCoinvolti
        )
      );
      allow create, update, delete: if isAdmin();
    }

    match /calendarEvents/{eventId} {
      allow read: if signedIn() && (
        resource.data.type != "SCADENZA_DOCUMENTO"
        || resource.data.ownerUserId == request.auth.uid
        || resource.data.sharedToAll == true
        || request.auth.uid in resource.data.authorizedUserIds
      );
      allow create: if signedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.title is string
        && request.resource.data.type in [
          "ferie",
          "permesso",
          "malattia",
          "intervento",
          "riunione",
          "formazione",
          "scadenza",
          "altro",
          "SCADENZA_DOCUMENTO"
        ];
      allow update: if signedIn()
        && (isAdmin() || resource.data.createdByUid == request.auth.uid)
        && request.resource.data.createdByUid == resource.data.createdByUid;
      allow delete: if signedIn()
        && (isAdmin() || resource.data.createdByUid == request.auth.uid);
    }

    match /documents/{documentId} {
      function ownsDocument(data) {
        return signedIn() && data.ownerUserId == request.auth.uid;
      }
      function canReadDocument(data) {
        return ownsDocument(data)
          || (data.visibility == "shared" && (data.sharedToAll == true || request.auth.uid in data.sharedUserIds))
          || data.visibility == "global";
      }
      allow read: if canReadDocument(resource.data);
      allow create: if signedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.visibility in ["personal", "shared", "global"]
        && request.resource.data.commessaIds is list
        && request.resource.data.uploadStatus == "completed"
        && request.resource.data.id == documentId
        && request.resource.data.fileUrl is string
        && request.resource.data.fileUrl.size() > 0
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.size() > 0
        && request.resource.data.mimeType is string
        && request.resource.data.mimeType.size() > 0
        && request.resource.data.fileSize is number
        && request.resource.data.fileSize > 0
        && request.resource.data.versionHistoryEnabled == false
        && (request.resource.data.visibility != "personal" || (
          request.resource.data.sharedToAll == false
          && request.resource.data.sharedUserIds.size() == 0
        ));
      allow update: if ownsDocument(resource.data)
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.visibility in ["personal", "shared", "global"]
        && request.resource.data.commessaIds is list
        && request.resource.data.uploadStatus in ["uploading", "completed", "failed"]
        && (request.resource.data.visibility != "personal" || (
          request.resource.data.sharedToAll == false
          && request.resource.data.sharedUserIds.size() == 0
        ));
      allow delete: if ownsDocument(resource.data);
    }

    match /documentReminderAcknowledgements/{acknowledgementId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Historical documents remain in their original path, but only their owner can
    // read or mutate them. Administrators intentionally receive no exception.
    match /privateDocuments/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /posDocuments/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    function validOperatorPositionWrite(userId) {
      return signedIn()
        && isSelf(userId)
        && request.resource.data.userId == userId
        && request.resource.data.uid == userId
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.stato in ["online", "offline"]
        && request.resource.data.status in ["online", "offline"];
    }


    match /appConfig/driveAdminSecret {
      allow read, write: if isAdmin();
    }

    match /appConfig/driveBridge {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /appConfig/{configId} {
      allow read, write: if signedIn() && !(configId in ["driveAdminSecret", "driveBridge"]);
    }

    match /activityLogs/{logId} {
      allow read, update, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    match /operatorPositions/{userId} {
      allow read: if isAdmin();
      allow create, update: if validOperatorPositionWrite(userId);
      allow delete: if isAdmin();
    }

    match /platformUsers/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create: if isAdmin() || (validPendingProfileCreate(userId) && createsNoInlinePosition() && createsNoPermissionFields() && createsNoBanFields());
      allow update: if isAdmin() || (isSelf(userId) && !isBannedUser() && updatesNoInlinePosition() && updatesNoPermissionFields() && updatesNoBanFields() && validSelfProfileUpdate());
      allow delete: if isAdmin();
    }

    match /userAccessAudit/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /chatMessages/{messageId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /safetyContacts/{contactId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Registri gestionali: consultazione agli utenti autenticati, modifiche e
    // matrici soltanto agli amministratori. Lo storico è append-only.
    match /personale/{personId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.linkedUserId == request.auth.uid
        && request.resource.data.linkedUserId == resource.data.linkedUserId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "emailVerified", "photoURL", "googleDisplayName",
          "linkedAuthProvider", "googleLastLoginAt", "updatedAt"
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["photoURL"])
          || resource.data.profilePhotoSource == "google"
        )
      );
    }

    match /mezzi/{vehicleId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /operatorCommessaHistory/{historyId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /registryImportBackups/{backupId} {
      allow read, create, delete: if isAdmin();
      allow update: if false;
    }

    match /userOperatorLinks/{userId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /operatorUserLinkHistory/{historyId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /{collection}/{docId} {
      allow read, write: if signedIn() && collection in [
        "appNotifications",
        "commessaResources",
        "globalCommesse",
        "gpsUpdateRequests",
        "hoursDeadlineAlerts",
        "items",
        "noteCommessa",
        "notificationEmailQueue",
        "oreApprovalRequests",
        "oreLocks",
        "oreReports",
        "neve_ore_richieste",
        "neve_ore",
        "sheetExportQueue",
        "userAlertAcknowledgements",
        "userAlerts",
        "utenti"
      ];

      match /{document=**} {
        allow read, write: if signedIn() && collection in [
          "globalCommesse"
        ];
      }
    }
  }
}
