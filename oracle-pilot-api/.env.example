# Never commit real credentials. Keep this API bound to loopback until TLS/reverse proxy is ready.
PORT=18082
# Inside Docker the process must bind all container interfaces; the host mapping remains loopback-only.
HOST=0.0.0.0
NODE_ENV=production
DATABASE_URL=postgresql://varga_reader:CHANGE_ME@db-postgres-1:5432/varga_cantieri
DB_SSL=false

# Existing Varga login, verified server-side. No Firebase database write is performed.
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=hera-app-6cd2b
# Enabling this requires an explicitly provisioned minimal Firebase Admin credential.
CHECK_REVOKED_TOKENS=false

# Deny by default: explicitly list pilot users, or issue a varga_access=true custom claim.
PILOT_ALLOWED_EMAILS=
PILOT_ADMIN_EMAILS=

# Exact web origins allowed to call the pilot API (comma separated).
ALLOWED_ORIGINS=http://127.0.0.1:18081,http://localhost:18081

# Alternative future OIDC mode (for example Oracle IAM/Identity Domains).
# AUTH_MODE=oidc
# OIDC_ISSUER=https://issuer.example/
# OIDC_AUDIENCE=varga-cantieri
# OIDC_JWKS_URI=https://issuer.example/.well-known/jwks.json
