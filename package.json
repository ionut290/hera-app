{
  "name": "hera-app",
  "private": true,
  "version": "1.0.0",
  "description": "Hera App web + Android wrapper via Capacitor",
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
