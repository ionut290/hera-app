{
  "name": "hera-app",
  "private": true,
  "version": "1.0.0",
  "description": "Hera App web + Android wrapper via Capacitor",
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:aab:prepare": "node scripts/prepare-capacitor-web.js",
    "sync:service-worker-assets": "node scripts/sync-service-worker-assets.js",
    "check:syntax": "node --check app.js",
    "check:app-update": "node scripts/check-app-update.js",
    "check:notifications": "node scripts/check-notification-experience.js",
    "check:auth-login": "node scripts/check-auth-login.js",
    "check:first-login-password": "node scripts/check-first-login-password.js",
    "check:login-retry": "node scripts/check-login-retry.js",
    "check:done-button": "node scripts/check-done-button-logic.js",
    "check:done-button-behavior": "node scripts/check-done-button-behavior.js",
    "check:android-done-push": "node scripts/check-android-done-push.js",
    "check:fatto-critical": "npm run check:syntax && npm run check:done-button && npm run check:done-button-behavior && npm run check:android-done-push",
    "check:fuel-stations": "node scripts/check-fuel-stations.js",
    "check:startup-splash": "node scripts/check-startup-splash.js",
    "check:today-summary": "node scripts/check-today-summary.js",
    "check:weather": "node scripts/check-weather.js",
    "check:calendar": "node scripts/check-calendar.js",
    "check:identity-card": "node scripts/check-identity-card-capture.js",
    "check:accounting-v2": "node scripts/check-accounting-v2.js && node scripts/check-inrete-work-items-v2.js && node scripts/check-coordinate-repair.js",
    "check:google-sheet-sync": "node scripts/check-google-sheet-two-way-sync.js",
    "check:segnalazione-pdf": "node scripts/check-segnalazione-pdf.js",
    "export:testers": "node scripts/export-firestore-emails.js",
    "check:map-fit": "node scripts/check-map-auto-fit.js",
    "check:management-v2": "node scripts/check-management-v2.js",
    "check:preventivi-models": "node scripts/check-preventivi-models.js"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^7.5.0",
    "@capacitor/android": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/geolocation": "^7.1.0",
    "@capacitor/push-notifications": "^7.0.2",
    "firebase": "^11.10.0"
  }
}
