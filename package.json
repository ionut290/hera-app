    "check:safe-listeners": "node scripts/check-firestore-safe-optimizer.js",
    "check:removed-product": "node scripts/check-commessa-produced-widget-removed.js",
    "check:inflight-reads": "node scripts/check-firestore-inflight-read-coalescer.js",
    "check:shared-calendar-trigger": "node scripts/check-shared-calendar-trigger.js",
    "check:shared-view-client": "node scripts/check-shared-view-client.js",
    "check:app-update": "node scripts/check-app-update.js",
    "check:notifications": "node scripts/check-notification-experience.js",
    "check:auth-login": "node scripts/check-auth-login.js",
    "check:first-login-password": "node scripts/check-first-login-password.js",
    "check:login-retry": "node scripts/check-login-retry.js",
    "check:done-button": "node scripts/check-done-button-logic.js",
    "check:done-button-behavior": "node scripts/check-done-button-behavior.js",
    "check:fatto-persistence-read-guard": "node scripts/check-fatto-persistence-read-guard.js",
    "check:android-done-push": "node scripts/check-android-done-push.js",
    "check:android-photo-share": "node scripts/check-android-whazzup-photo-share.js",
    "check:photo-notes": "node scripts/check-whazzup-photo-notes.js",
    "check:whatsapp-protection": "node scripts/check-whatsapp-protection.js",
    "check:fatto-critical": "npm run check:syntax && npm run check:safe-listeners && npm run check:removed-product && npm run check:inflight-reads && npm run check:shared-calendar-trigger && npm run check:done-button && npm run check:done-button-behavior && npm run check:fatto-persistence-read-guard && npm run check:android-done-push && npm run check:android-photo-share && npm run check:photo-notes && npm run check:whatsapp-protection",
    "check:fuel-stations": "node scripts/check-fuel-stations.js",
    "check:startup-splash": "node scripts/check-startup-splash.js",
    "check:today-summary": "node scripts/check-today-summary.js",
    "check:weather": "node scripts/check-weather.js",
    "check:calendar": "node scripts/check-calendar.js",
    "check:identity-card": "node scripts/check-identity-card-capture.js",
    "check:accounting-v2": "node scripts/check-accounting-v2.js && node scripts/check-inrete-work-items-v2.js && node scripts/check-coordinate-repair.js",
    "check:google-sheet-sync": "node scripts/check-google-sheet-two-way-sync.js",
    "check:segnalazione-pdf": "node scripts/check-segnalazione-pdf.js",
    "export:testers": "node scripts/export-firestore-emails.js",
    "check:map-fit": "node scripts/check-map-auto-fit.js",
    "check:management-v2": "node scripts/check-management-v2.js",
    "check:preventivi-models": "node scripts/check-preventivi-models.js",
    "check:preventivi-registry-model": "node scripts/check-preventivi-registry-model-fix.js",
    "check:preventivi-model-field-recovery": "node scripts/check-preventivi-model-field-recovery.js",
    "check:preventivi-avola-system-model": "node scripts/check-preventivi-avola-system-model.js",
    "check:preventivi-models-visibility": "node scripts/check-preventivi-models-visibility.js",
    "check:preventivi-matrix-runtime": "node scripts/check-preventivi-matrix-runtime-fix.js",
    "check:preventivi-commessa-search": "node scripts/check-preventivi-commessa-search-bridge.js",
    "check:preventivi-template-fidelity": "node scripts/check-preventivi-template-fidelity.js"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^7.5.0",
    "@capacitor/android": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/geolocation": "^7.1.0",
    "@capacitor/push-notifications": "^7.0.2",
    "@capacitor/share": "^7.0.4",
    "firebase": "^11.10.0"
  }
