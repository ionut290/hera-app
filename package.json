{
  "name": "hera-app",
  "private": true,
  "version": "1.0.0",
  "description": "Hera App web + Android wrapper via Capacitor",
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "check:syntax": "node --check app.js",
    "check:done-button": "node scripts/check-done-button-logic.js",
    "check:fuel-stations": "node scripts/check-fuel-stations.js",
    "check:multi-company": "node scripts/check-multi-company.js"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0"
  },
  "dependencies": {
    "@capacitor/core": "^7.2.0",
    "@capacitor/android": "^7.2.0"
  }
}
