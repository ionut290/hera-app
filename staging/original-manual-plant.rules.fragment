// Emulator candidate, not deployed. Original manual insertion and price-code merge.
// Separate capability because the original handler uses two non-atomic writes.
function originalManualAllowed() {
 return canManageCommesse()
 && get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('originalCreateEnabled',false)==true
 && get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('originalManualEnabled',false)==true;
}
function manualPlantMerge() {
 return originalManualAllowed()
 && resource.data.keys().hasOnly(manualPlantKeys()) && resource.data.keys().hasAll(manualPlantKeys())
 && resource.data.done==false
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['codicePrezzo','voceRiferimento','tipologiaIntervento','lavorazioniRichieste','frequenzaAnnua','hasOrdinario','hasStraordinario','tipoManutenzione'])
 && validManualPrices(request.resource.data);
}
match /commesse/{commessaId} {
 allow update: if commessaId!='sfalcio-cobo' && originalManualAllowed()
 && resource.data.get('excelModelVersion',0)==2
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextImpiantoNumber'])
 && request.resource.data.nextImpiantoNumber is int
 && request.resource.data.nextImpiantoNumber>=resource.data.nextImpiantoNumber
 && request.resource.data.nextImpiantoNumber<=resource.data.nextImpiantoNumber+1;
 match /impianti/{impiantoId} {
  allow update: if commessaId!='sfalcio-cobo' && manualPlantMerge();
 }
}
