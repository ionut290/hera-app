// Candidate only. Count actual squad rows, not documents or historical days.
// The tenant counter write validates the complete operation once. Current/history
// writes must prove the same new operation marker, bound to archive, job and date.
function squadArchive(a) { return a in ['squadreCommesse','neve_squadre']; }
function squadHistory(a) { return a=='squadreCommesse'?'squadreStorico':'neve_squadre_storico'; }
function squadCurrent(a) { return a=='squadreStorico'?'squadreCommesse':'neve_squadre'; }
function squadJob(a) { return a=='squadreCommesse'?'commesse':'neve_commesse'; }
function squadPriorCount(a,id) {
 return exists(/databases/$(database)/documents/tenants/$(tenantId)/$(a)/$(id))
  ? get(/databases/$(database)/documents/tenants/$(tenantId)/$(a)/$(id)).data.squadre.size() : 0;
}
function squadValid(a,id,d) {
 let job=squadJob(a);
 return d.keys().hasOnly(['commessaId','commessaNome','riferimentoData','squadre','updatedAt','updatedBy','existingSquadreCountBeforeSave'])
  && d.commessaId==id && d.commessaNome is string && d.commessaNome.size()<=250
  && d.riferimentoData is string && d.riferimentoData.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
  && d.squadre is list && d.squadre.size()>0 && d.squadre.size()<=100
  && d.existingSquadreCountBeforeSave is int && d.existingSquadreCountBeforeSave>=0
  && d.updatedAt==request.time && d.updatedBy==request.auth.token.email
  && exists(/databases/$(database)/documents/tenants/$(tenantId)/$(job)/$(id));
}
function squadCounterCheck(q) {
 let d=getAfter(/databases/$(database)/documents/tenants/$(tenantId)/$(q.archive)/$(q.id)).data;
 let a=squadHistory(q.archive);
 let hId=q.date+'__'+q.id;
 let h=getAfter(/databases/$(database)/documents/tenants/$(tenantId)/$(a)/$(hId)).data;
 let old=resource.data.usage.squadre;
 let n=request.resource.data.usage.squadre;
 return squadValid(q.archive,q.id,d) && d.riferimentoData==q.date
  && old is int && old>=0 && n is int
  && n==old-squadPriorCount(q.archive,q.id)+d.squadre.size()
  && n>=0 && n<=resource.data.limits.squadre
  && h.dateKey==q.date && h.diff(d).affectedKeys().hasOnly(['dateKey']);
}
function squadCounterUpdate() {
 let q=request.resource.data.lastSquadraWrite;
 return q.keys().hasOnly(['archive','id','date','at']) && squadArchive(q.archive)
  && q.id is string && q.date is string && q.at==request.time
  && q!=resource.data.get('lastSquadraWrite',{})
  && request.resource.data.usage.diff(resource.data.usage).affectedKeys().hasOnly(['squadre'])
  && companyAdmin(tenantId) && planWritable(tenantId) && managedPlan(resource.data)
  && resource.data.get('originalArchivesEnabled',false)==true && squadCounterCheck(q);
}
allow update: if request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSquadraWrite'])
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usage','lastSquadraWrite'])
 && squadCounterUpdate();
function squadMarker(a,id,date) {
 let b=get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('lastSquadraWrite',{});
 let n=getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data.get('lastSquadraWrite',{});
 return n=={'archive':a,'id':id,'date':date,'at':request.time} && b!=n;
}
match /{archive}/{id} {
 allow create,update: if squadArchive(archive) && eligible()
  && request.resource.data.updatedAt==request.time
  && squadMarker(archive,id,request.resource.data.riferimentoData);
 allow create,update: if archive in ['squadreStorico','neve_squadre_storico'] && eligible()
  && request.resource.data.updatedAt==request.time
  && id==request.resource.data.dateKey+'__'+request.resource.data.commessaId
  && squadMarker(squadCurrent(archive),request.resource.data.commessaId,request.resource.data.dateKey);
 // Delete stays denied until a reviewed counter release and history policy exists.
}
