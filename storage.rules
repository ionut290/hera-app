rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /documents/{ownerUserId}/{documentId}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == ownerUserId
        && fileName.size() <= 120
        && (request.resource == null || request.resource.size <= 15 * 1024 * 1024);
      allow read: if request.auth != null && (
        request.auth.uid == ownerUserId
        || firestore.get(/databases/(default)/documents/documents/$(documentId)).data.visibility == 'global'
        || (firestore.get(/databases/(default)/documents/documents/$(documentId)).data.visibility == 'shared'
          && (firestore.get(/databases/(default)/documents/documents/$(documentId)).data.sharedToAll == true
            || request.auth.uid in firestore.get(/databases/(default)/documents/documents/$(documentId)).data.sharedUserIds))
      );
    }

    // Compatibilità con i PDF già caricati nei Lavori occasionali.
    match /lavori-occasionali/{plantId}/{ownerUserId}/{documentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == ownerUserId
        && fileName.size() <= 120
        && (
          request.resource == null
          || (
            request.resource.size <= 15 * 1024 * 1024
            && request.resource.contentType == 'application/pdf'
          )
        );
    }

    // Nuovo percorso unico per PDF di impianti/cantieri di qualunque commessa.
    match /impianti-pdf/{commessaId}/{plantId}/{ownerUserId}/{documentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == ownerUserId
        && commessaId.size() > 0
        && plantId.size() > 0
        && fileName.size() <= 120
        && (
          request.resource == null
          || (
            request.resource.size <= 15 * 1024 * 1024
            && request.resource.contentType == 'application/pdf'
          )
        );
    }
  }
}
