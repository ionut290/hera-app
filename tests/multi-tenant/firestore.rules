// PROTOTIPO EMULATOR ONLY. Non referenziato da firebase.json di produzione.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function eligible() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('apple_review', false) == false;
    }
    function activeMember(tenantId) {
      return eligible()
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.status == 'active'
        && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.status == 'active';
    }
    match /tenants/{tenantId} {
      allow get: if activeMember(tenantId);
      allow list, create, update, delete: if false;
      // First operational pilot: only company owner/admin may read top-level jobs.
      // Client writes, worker access and protected job subcollections remain denied
      // until their exact business permissions and regressions are verified.
      match /commesse/{commessaId} {
        allow get, list: if activeMember(tenantId)
          && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role in ['owner', 'admin'];
        allow create, update, delete: if false;
      }
      match /members/{uid} {
        allow get: if activeMember(tenantId) && request.auth.uid == uid;
        allow list, create, update, delete: if false;
      }
    }
    match /users/{uid}/memberships/{tenantId} {
      // Indice personale, NON autorizzazione. La selezione deve verificare activeMember.
      allow get, list: if eligible() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
